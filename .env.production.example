# Copy to `.env.production`, fill in real values, then run: npm run start:production
#
# MUST be a real, externally-reachable HTTPS host, never localhost/127.0.0.1/
# 10.0.2.2/a LAN IP -- src/config/env.ts refuses to start a production build
# pointed at one of those.

EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_API_BASE_URL=https://api.afilianet.example
EXPO_PUBLIC_API_TIMEOUT_MS=15000

EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
