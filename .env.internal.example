# Copy to `.env.internal`, fill in a real value, then run: npm run start:internal
#
# Internal Alpha builds/runs against a REAL backend -- there is no working
# default here the way `.env.example`'s 127.0.0.1 works for a simulator.
# A physical phone cannot reach your PC's `localhost`/`127.0.0.1` at all
# (Docker Desktop included), so pick ONE of:
#
#   - Your dev machine's LAN IP (e.g. http://192.168.1.23:8000), with the
#     afilianet-api Docker stack running and the phone on the SAME Wi-Fi.
#     Windows: `ipconfig` -> "IPv4 Address". This is the realistic path for
#     a same-network internal Alpha today.
#   - A real deployed internal/staging afilianet-api URL, once one exists.
#
# This file (and the real `.env.internal` you create from it) is never
# committed -- see README.md "Environments" for the full breakdown of what
# EXPO_PUBLIC_* values are safe to bundle into the client.

EXPO_PUBLIC_APP_ENV=internal
EXPO_PUBLIC_API_BASE_URL=http://YOUR-LAN-IP:8000
EXPO_PUBLIC_API_TIMEOUT_MS=15000

EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
