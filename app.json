{
  "expo": {
    "name": "Afilianet",
    "slug": "afilianet-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/afilianet-app-icon-1024.png",
    "scheme": "afilianetmobile",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/android-adaptive-foreground-432.png",
        "backgroundImage": "./assets/brand/android-adaptive-background-432.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0A14",
          "image": "./assets/brand/afilianet-app-icon-1024.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Afilianet to access your camera to capture identity documents for verification.",
          "microphonePermission": false,
          "photosPermission": false
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
