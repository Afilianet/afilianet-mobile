{
  "expo": {
    "name": "Afilianet",
    "slug": "afilianet-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/afilianet-app-icon-1024.png",
    "scheme": "afilianetmobile",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.afilianet.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/android-adaptive-foreground-432.png",
        "backgroundImage": "./assets/brand/android-adaptive-background-432.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.afilianet.mobile",
      "supportsTablet": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/afilianet-app-icon-1024.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Afilianet necesita acceder a tu c\u00e1mara para fotografiar tu identificaci\u00f3n y verificar tu identidad.",
          "microphonePermission": false,
          "photosPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Afilianet puede usar tu ubicaci\u00f3n, de forma opcional, para ayudar a proteger tu cuenta durante la verificaci\u00f3n de identidad.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "@sentry/react-native",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      "./plugins/withAndroidCoreLibraryDesugaring",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5675cfc3-13b6-425d-92bc-0d6067845ed0"
      }
    }
  }
}
