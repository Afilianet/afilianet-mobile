# Copy this file to `.env` for local development: cp .env.example .env
# (On Windows PowerShell: Copy-Item .env.example .env)
#
# See README.md "Changing the API URL" for exactly which value to use here
# depending on how you're running the app (iOS Simulator, Android Emulator,
# or a physical phone).

EXPO_PUBLIC_APP_ENV=development

# In the afilianet-api folder, run: php artisan serve --host=0.0.0.0 --port=8000
# This value works from the iOS Simulator as-is. See README.md for the
# Android Emulator (10.0.2.2) and physical-phone (LAN IP) equivalents.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Leave blank to disable Sentry/PostHog -- both no-op gracefully when empty.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
