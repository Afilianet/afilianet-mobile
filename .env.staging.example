# Copy to `.env.staging`, fill in real values, then run: npm run start:staging
# (this file is for running LOCALLY against staging via Metro -- an
# `eas build --profile staging` instead reads EXPO_PUBLIC_API_BASE_URL from
# EAS's own hosted Environment Variables, never from this file; see
# README.md "Environments" and eas.json's `staging` profile).
#
# MUST be a real, externally-reachable HTTPS host, never localhost/127.0.0.1/
# 10.0.2.2/a LAN IP -- src/config/env.ts refuses to start a staging build
# pointed at one of those.

EXPO_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_API_BASE_URL=https://staging-api.afilianet.example
EXPO_PUBLIC_API_TIMEOUT_MS=15000

EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
