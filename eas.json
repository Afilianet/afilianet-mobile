{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "developmentClient": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.68.110:8000"
      }
    },
    "internal": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "internal"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_NO_DOTENV": "1"
      },
      "environment": "production"
    },
    "staging": {
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://staging-api.afilianet.mx",
        "EXPO_NO_DOTENV": "1"
      }
    },
    "store-beta": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://staging-api.afilianet.mx",
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_SURVEYS_PREVIEW": "0",
        "EXPO_PUBLIC_SENTRY_ENABLED": "0",
        "EXPO_PUBLIC_SENTRY_DSN": "disabled",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "store-beta-apk": {
      "extends": "store-beta",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "privacy-test-apk": {
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "internal",
        "EXPO_PUBLIC_API_BASE_URL": "https://andres-desk.tail7be8f8.ts.net",
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_SURVEYS_PREVIEW": "0",
        "EXPO_PUBLIC_SENTRY_ENABLED": "0",
        "EXPO_PUBLIC_SENTRY_DSN": "disabled",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "development-staging": {
      "extends": "staging",
      "developmentClient": true,
      "android": {
        "gradleCommand": ":app:assembleDebug"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
